{
    "version": 2,
    "regions": ["hnd1"],
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.9.0"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(build|images|fonts)/(.*)",
            "headers": {
                "cache-control": "public, max-age=31536000, immutable"
            },
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(storage)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(.*\\.(ico|txt|png|jpg|jpeg|gif|svg|woff2?|ttf|eot))$",
            "headers": {
                "cache-control": "public, max-age=86400"
            },
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "CACHE_STORE": "array",
        "CACHE_DRIVER": "array",
        "SESSION_DRIVER": "cookie",
        "QUEUE_CONNECTION": "sync",
        "VIEW_COMPILED_PATH": "/tmp"
    }
}

